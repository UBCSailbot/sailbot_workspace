<?xml version="1.0"?>
<model>
  <name>polaris</name>
  <version>1.0</version>
  <sdf version="1.11">model.sdf</sdf>

  <author>
    <name>UBC Sailbot</name>
    <email>software@ubcsailbot.org</email>
  </author>

  <description>
    Polaris with the real CAD hull geometry, for the boat simulator's Gazebo backend.
    Satisfies the model contract in src/boat_simulator_gazebo/README.md. Physically
    identical to models/polaris_basic -- same links, joints, mass, inertia and plugin
    parameters, all from BOAT_PROPERTIES -- and differs only in visual geometry, which
    comes from the SolidWorks export in urdf/polaris.urdf via
    tools/prepare_polaris_meshes.py.
  </description>
</model>
