<?xml version="1.0"?>
<model>
  <name>polaris</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>UBC Sailbot</name>
    <email>software@ubcsailbot.org</email>
  </author>

  <description>
    Example boat model for the boat simulator's Gazebo backend. A coarse geometric
    stand-in for Polaris that satisfies the model contract in
    src/boat_simulator_gazebo/README.md, using the mass, inertia, foil areas, and centre
    of effort offsets from boat_simulator/common/constants.py.
  </description>
</model>
