<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sailing world for the Gazebo (gz-sim, Harmonic) physics backend of the boat simulator.

  Provides:
    - Physics + standard gz-sim world systems.
    - An asv_wave_sim FFT wave field, which is both the visible water surface and the
      surface the boat's Hydrodynamics plugin integrates against.
    - A constant true wind field with the WindEffects system.

  Flotation is NOT provided here. The stock gz-sim Buoyancy system is deliberately absent:
  it applies a buoyant force that does not shift as the hull heels, so it produces no
  waterplane righting moment, and any model using it has to be artificially ballasted
  CG-below-CB to stay upright. asv_wave_sim's Hydrodynamics plugin instead integrates over
  the submerged part of the collision mesh, which yields the righting moment for free.
  That plugin lives on the boat model, not in this world.

  The boat model itself is NOT part of this world. It is spawned by gazebo_launch.py and
  must satisfy the model contract in this package's README (model name `polaris`, joints
  `rudder_joint`/`trim_tab_joint`, OdometryPublisher + JointPositionController + LiftDrag
  + Hydrodynamics plugins).

  The constant wind vector below must stay in sync with the `true_wind_enu_mps` parameter
  of gazebo_physics_bridge_node in src/global_launch/config/globals.yaml, since the bridge
  node uses that parameter to publish the WindSensor topic.
-->
<sdf version="1.9">
  <world name="sailing_world">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Applies the world <wind> vector to links with <enable_wind> and feeds the
         LiftDrag systems on the boat's sail. -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1.0</force_approximation_scaling_factor>
    </plugin>

    <!-- Constant true wind, ENU frame, m/s. 1.389 m/s = 5 km/h per component, matching
         the kinematic backend's wind_generation mean in globals.yaml. -->
    <wind>
      <linear_velocity>1.389 1.389 0</linear_velocity>
    </wind>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.85 0.95 1</background>
      <sky/>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- asv_wave_sim wave field: both the visible water surface and the surface the boat's
         Hydrodynamics plugin integrates against. Resolved from GZ_SIM_RESOURCE_PATH, which
         gazebo_launch.py points at src/asv_wave_sim/gz-waves-models/world_models.

         The <wave> block overrides the model's shipped defaults so the sea state matches
         this world's wind: 1.96 m/s magnitude on a 45 degree bearing, i.e. the ENU wind
         vector above. That is a light breeze, so the surface stays nearly flat; raise
         wind_speed to exercise the boat in a rougher sea.

         These parameters must be kept identical to the <wave> block of the Hydrodynamics
         plugin in models/polaris/model.sdf. The two systems evaluate the wave field
         independently, so if they disagree the boat floats against a surface that is not
         the one being drawn. -->
    <include>
      <uri>model://waves</uri>
      <pose>0 0 0 0 0 0</pose>
      <plugin filename="gz-waves1-waves-model-system" name="gz::sim::systems::WavesModel">
        <static>0</static>
        <update_rate>30</update_rate>
        <wave>
          <algorithm>fft</algorithm>
          <tile_size>256</tile_size>
          <cell_count>256</cell_count>
          <wind_speed>1.96</wind_speed>
          <wind_angle_deg>45</wind_angle_deg>
          <steepness>2</steepness>
        </wave>
      </plugin>
    </include>
  </world>
</sdf>
